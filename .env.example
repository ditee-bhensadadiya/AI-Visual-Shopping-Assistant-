# Server-side URL and service-role key. Never expose the key in frontend code.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key


# API configuration
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Phase 3 image upload configuration
MAX_UPLOAD_BYTES=10485760

# Optional local YOLO adapter configuration
YOLO_MODEL_PATH=yolo26n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.7
YOLO_MAX_DETECTIONS=50

# Local Ollama vision model (no per-image API charge).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
